      &RESERVATION;
      &PLOT_RESOURCES;

      <command>&HOMEDIR;/rocoto/launch_qpf_verif</command>
      <nodes> 1:ppn=20 </nodes>
      <join><cyclestr>&LOG_DIR;/qpf_4panel_@Y@m@d@H_f#fhr#.log</cyclestr></join>
      <jobname>qpf_4panel_f#fhr#</jobname>

      <envar><name>HOMEDIR</name><value>&HOMEDIR;</value></envar>
      <envar><name>COMrrfs</name><value>&COMrrfs;</value></envar>
      <envar><name>COMhrrr</name><value>&COMhrrr;</value></envar>
