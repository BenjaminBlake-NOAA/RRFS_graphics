<!-- ********************************************************* -->
<!-- **************** STARTING THE WORKFLOW ****************** -->
<!-- ********************************************************* -->

<workflow realtime="T" scheduler="pbspro" cyclelifespan="00:12:00:00" cyclethrottle="2" taskthrottle="50">

  <cycledef group="verif" activation_offset="04:00:00:00">202505101200 202512311800 06:00:00</cycledef>
 
