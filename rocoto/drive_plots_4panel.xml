<!-- ******************************************************** -->

<!-- ****** 4 PANEL PLOTS ****** -->
<!-- ****** HRRR/NAM vs NAM Nest vs RRFS Control vs Verification ****** -->

<!-- ****** QPF ****** -->
  <metatask>
    <var name="fhr">24 30 36 42 48 54 60</var>
